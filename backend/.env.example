# IntraLocate Backend Environment Configuration Example
# Copy this file to .env and fill in your values.

# Database URL (MySQL)
# Local MySQL:
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/indoor_localization"

# Free Cloud MySQL (e.g., TiDB Cloud Serverless / Clever Cloud):
DATABASE_URL="mysql://username:password@gateway01.region.prod.aws.tidbcloud.com:4000/indoor_localization?sslaccept=strict"

# JWT Secret Key for Session Authentication
JWT_SECRET="your-ultra-secure-jwt-secret-key-at-least-32-characters"

# Server Host & Port
HOST="0.0.0.0"
PORT=3000
